# Copy to .env (git-ignored) and replace every change-me. Local use only.
# `make up` writes one with random values if there is none, and puts them in a cluster Secret.
POSTGRES_PASSWORD=change-me
# Uncomment if 5432 is taken, and change the port in DATABASE_URL too.
# POSTGRES_PORT=5433
# Uncomment to change the mock payer's port, or to turn its injected faults off.
# MOCK_PAYER_PORT=8002
# MOCK_PAYER_PROFILE=calm
DATABASE_URL=postgresql://coverage_check:change-me@127.0.0.1:5432/coverage_check
COVERAGE_CHECK_API_TOKEN=change-me
