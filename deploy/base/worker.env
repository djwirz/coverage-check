WORKER_PAYER_URL=http://mock-payer:8000
# The payer allows 20 a second and 10 in flight (mock-payer/default.toml, ADR 0010).
WORKER_RATE_PER_SECOND=16
WORKER_BURST=2
WORKER_MAX_IN_FLIGHT=8
WORKER_CONCURRENCY=4
# Longer than any call; the pod's termination grace period is longer still.
WORKER_SHUTDOWN_GRACE_SECONDS=40
WORKER_HEALTH_DIR=/tmp/health
# Where traces go. Unset, there are none (tracing.py).
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
